# PostgreSQL bağlantısı (zorunlu)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Google Maps / Places (tarayıcı anahtarını HTTP referrer ile kısıtlayın)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# İlk kurulumda oluşturulacak admin hesabı
ADMIN_EMAIL=
ADMIN_PASSWORD=

# sync-google rotasının kendi adresine istek atması için
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Oturum çerezi imzalama anahtarı (ZORUNLU, production'da en az 32 karakter)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
